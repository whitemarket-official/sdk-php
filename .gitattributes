* text=auto eol=lf

# Generated code: collapsed in diffs, excluded from language stats
/src/Generated/** linguist-generated=true
/schema/partner.graphql linguist-generated=true
/schema/partner.introspection.json linguist-generated=true
/graphql/operations/** linguist-generated=true
/graphql/fragments/** linguist-generated=true

