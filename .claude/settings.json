{
  "outputStyle": "Terse",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $CLAUDE_PROJECT_DIR/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(php -l *)",
      "Bash(php -v)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/php-cs-fixer *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git merge *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list*)",
      "Read",
      "Glob",
      "Grep",
      "Skill(quality-checks)",
      "Skill(clean-code-review)",
      "Skill(secure-coding)",
      "Skill(security-review)",
      "Skill(testing)",
      "Skill(schema-update)",
      "Skill(add-sdk-method)",
      "Skill(clarify-spec)",
      "Skill(analyze-plan)",
      "Skill(pr-review)",
      "Skill(sync-task-branch)",
      "Skill(release-notes)",
      "Skill(handoff)",
      "Skill(pickup)",
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:dispatching-parallel-agents)",
      "Skill(superpowers:executing-plans)",
      "Skill(superpowers:finishing-a-development-branch)",
      "Skill(superpowers:receiving-code-review)",
      "Skill(superpowers:requesting-code-review)",
      "Skill(superpowers:subagent-driven-development)",
      "Skill(superpowers:systematic-debugging)",
      "Skill(superpowers:test-driven-development)",
      "Skill(superpowers:using-git-worktrees)",
      "Skill(superpowers:using-superpowers)",
      "Skill(superpowers:verification-before-completion)",
      "Skill(superpowers:writing-plans)",
      "Skill(superpowers:writing-skills)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git tag*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",

      "Edit(./.claude/**)",
      "Edit(./.mcp.json)",
      "Edit(./CLAUDE.md)",
      "Edit(~/.claude/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.env_*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./**/.env_*)",

      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",

      "Read(./**/secrets/**)",
      "Edit(./**/secrets/**)",
      "Read(./var/live-smoke/token*)",
      "Edit(./var/live-smoke/token*)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",

      "mcp__phpstorm__execute_terminal_command",
      "mcp__phpstorm__execute_run_configuration",
      "mcp__phpstorm__build_project",
      "mcp__intellij-mcp__run_configuration",

      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "codegraph"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/grep-streak.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/reread-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/generated-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|Read|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/untrusted-output.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript >/dev/null 2>&1 && osascript -e 'display notification \"Claude needs attention\" with title \"Claude Code\"' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript >/dev/null 2>&1 && osascript -e 'display notification \"Claude needs attention\" with title \"Claude Code\"' || true"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/reuse-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/suppress-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/session-size.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/session-cap.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/style-reinject.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
